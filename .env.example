# Environment configuration for PAOS Live Operations
# Copy this to .env and fill in your values

# API Configuration
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://paos:paospass@localhost:5432/paos_operations

# Redis (for caching and real-time events)
REDIS_URL=redis://localhost:6379

# AI Provider Keys
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ENCRYPTION_KEY=your-32-character-encryption-key!

# Agent Configuration
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300

# Approval Requirements
REQUIRE_APPROVAL_FOR_COMMUNICATE=true
REQUIRE_APPROVAL_FOR_PURCHASE=true
REQUIRE_APPROVAL_FOR_FINANCIAL=true
REQUIRE_APPROVAL_FOR_IRREVERSIBLE=true
